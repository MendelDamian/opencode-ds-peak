{
  "name": "opencode-ds-peak",
  "version": "0.1.0",
  "description": "Minimal opencode TUI sidebar dot showing whether DeepSeek is in peak or off-peak pricing, with a countdown to the next switch. Five languages.",
  "keywords": [
    "opencode",
    "tui",
    "plugin",
    "deepseek",
    "pricing",
    "peak",
    "off-peak",
    "sidebar",
    "i18n"
  ],
  "license": "MIT",
  "author": "MendelDamian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MendelDamian/opencode-ds-peak.git"
  },
  "homepage": "https://github.com/MendelDamian/opencode-ds-peak",
  "bugs": {
    "url": "https://github.com/MendelDamian/opencode-ds-peak/issues"
  },
  "type": "module",
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "sanity": "node --experimental-strip-types scripts/sanity-check.mjs",
    "check": "npm run typecheck && npm run sanity",
    "pack": "npm pack --dry-run"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": "^1.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.29"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.34",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6"
  }
}
